---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Soluvirtus - Consultora de tecnología y desarrollo. Encontrando soluciones, impulsando virtudes." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css?family=Roboto+Mono:300,400,500,700&display=swap" rel="stylesheet">
		
		<!-- Preload LCP Asset -->
		<link rel="preload" as="image" href="/images/hero_bg.png" />
		<link rel="preload" as="image" href="/images/hero_bg_light.png" />

		<link rel="canonical" href="https://soluvirtus.com/" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Antonio Ávila" />
		<meta name="keywords" content="Soluvirtus, automatización de negocios, agentes de IA, IA local, desarrollo de software a medida, Next.js, Supabase, scrapers de leads, consultora de tecnología" />
		
		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://soluvirtus.com/" />
		<meta property="og:site_name" content="Soluvirtus" />
		<meta property="og:title" content="SOLUVIRTUS - Consultora de Tecnología y Automatización de Negocios" />
		<meta property="og:description" content="Acelera, delega y simplifica tu trabajo. Automatización sólida con agentes de IA, desarrollo full-stack a la medida e infraestructura soberana." />
		<meta property="og:image" content="https://soluvirtus.com/images/hero_bg.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://soluvirtus.com/" />
		<meta property="twitter:title" content="SOLUVIRTUS - Consultora de Tecnología y Automatización de Negocios" />
		<meta property="twitter:description" content="Acelera, delega y simplifica tu trabajo. Automatización sólida con agentes de IA, desarrollo full-stack a la medida e infraestructura soberana." />
		<meta property="twitter:image" content="https://soluvirtus.com/images/hero_bg.png" />

		<!-- JSON-LD Schema Enriquecido -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ProfessionalService",
				"name": "Soluvirtus",
				"alternateName": "Soluvirtus Tech Consulting",
				"description": "Consultora boutique de tecnología y automatización inteligente con enfoque agent-first. Desarrollo de software full-stack a medida, integración de IA local soberana y optimización de flujos operativos.",
				"url": "https://soluvirtus.com/",
				"telephone": "+525570603839",
				"priceRange": "$$$",
				"founder": {
					"@type": "Person",
					"name": "Antonio Ávila",
					"jobTitle": "Lead Software Engineer & Automation Consultant"
				},
				"address": {
					"@type": "PostalAddress",
					"addressCountry": "MX",
					"addressLocality": "Ciudad de México"
				},
				"sameAs": [
					"https://www.linkedin.com/in/av-soluvirtus/"
				],
				"knowsAbout": [
					"Software Engineering",
					"Artificial Intelligence & Autonomous Agents",
					"Business Process Automation",
					"Full-Stack Development (Next.js, Astro, React, Supabase)",
					"Local LLMs & Data Sovereignty",
					"High-Performance Web Applications"
				],
				"hasOfferCatalog": {
					"@type": "OfferCatalog",
					"name": "Servicios de Tecnología Soluvirtus",
					"itemListElement": [
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Diagnóstico y Auditoría de Automatización Express",
								"description": "Evaluación técnica de procesos manuales y plan de automatización con agentes de IA."
							}
						},
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Ingeniería de Software a Medida",
								"description": "Desarrollo de plataformas web de alto rendimiento sin CMS lentos."
							}
						}
					]
				}
			}
		</script>

		<!-- Script to set default dark/light mode based on system preference -->
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList.toggle('dark', isDark);
		</script>
	</head>
	<body class="bg-brand-bg-light dark:bg-brand-bg-dark text-brand-text-light secondary-text dark:text-brand-text-dark font-mono transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family: 'Roboto Mono', monospace;
	}
	
	/* Sugerencia 15: Transición global suave para cambios de tema */
	body,
	nav,
	div,
	section,
	table,
	tr,
	td,
	th,
	button,
	span,
	h1, h2, h3, h4, h5, h6,
	a,
	p,
	svg,
	input,
	textarea {
		transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease, box-shadow 0.4s ease, text-shadow 0.4s ease, opacity 0.4s ease;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(4px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fadeIn 0.25s ease-out forwards;
	}

	.text-neon-glow {
		text-shadow: 0 0 8px rgba(2, 132, 199, 0.2);
	}
	.dark .text-neon-glow {
		text-shadow: 0 0 8px rgba(0, 240, 255, 0.5), 0 0 15px rgba(0, 240, 255, 0.2);
	}

	/* Scroll Reveal */
	.reveal {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.reveal-active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Sugerencia 4: Gradiente Animado */
	@keyframes gradientMove {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}
	.animate-gradient {
		background-size: 200% 200%;
		animation: gradientMove 12s ease infinite;
	}
</style>
