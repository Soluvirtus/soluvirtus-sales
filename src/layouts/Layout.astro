---
interface Props {
	title: string;
	description?: string;
	lang?: string;
}

const { 
	title, 
	description = "Soluvirtus - Consultora boutique de tecnología y desarrollo a medida. Automatización inteligente, agentes de IA soberana e ingeniería web de alto rendimiento.",
	lang = "es"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://soluvirtus.com");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>{title}</title>
		
		<!-- Performance: DNS Prefetch & Google Fonts Preconnect -->
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		<link rel="dns-prefetch" href="https://fonts.gstatic.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
		
		<!-- Preload Critical Above-the-fold Assets -->
		<link rel="preload" as="image" href="/images/hero_bg.png" fetchpriority="high" />

		<!-- Canonical & Alternates -->
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="alternate" hreflang="es" href="https://soluvirtus.com/" />
		<link rel="alternate" hreflang="en" href="https://soluvirtus.com/en/" />
		<link rel="alternate" hreflang="x-default" href="https://soluvirtus.com/" />

		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<meta name="author" content="Antonio Ávila" />
		<meta name="keywords" content="Soluvirtus, automatización de negocios, agentes de IA, IA local, desarrollo de software a medida, Next.js, Supabase, scrapers de leads, consultora de tecnología, Antonio Ávila" />
		
		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content="Soluvirtus" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://soluvirtus.com/images/hero_bg.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Soluvirtus - Consultora de Tecnología y Automatización con IA" />
		<meta property="og:locale" content={lang === "en" ? "en_US" : "es_MX"} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL.href} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://soluvirtus.com/images/hero_bg.png" />
		<meta name="twitter:image:alt" content="Soluvirtus - Consultora de Tecnología y Automatización con IA" />

		<!-- JSON-LD Graph Completo (E-E-A-T, GEO y Motores de Búsqueda IA) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "ProfessionalService",
						"@id": "https://soluvirtus.com/#organization",
						"name": "Soluvirtus",
						"alternateName": ["Soluvirtus Tech Consulting", "Soluvirtus IA & Software"],
						"url": "https://soluvirtus.com/",
						"logo": "https://soluvirtus.com/images/hero_bg.png",
						"image": "https://soluvirtus.com/images/hero_bg.png",
						"description": "Consultora boutique de tecnología e ingeniería de software a la medida enfocada en automatización de procesos nativos, agentes autónomos de Inteligencia Artificial (agent-first) e infraestructura soberana con enfoque QA-First.",
						"telephone": "+525570603839",
						"priceRange": "$$$",
						"founder": {
							"@type": "Person",
							"@id": "https://soluvirtus.com/#founder",
							"name": "Antonio Ávila",
							"jobTitle": "Lead Software Engineer & Automation Architect",
							"sameAs": [
								"https://www.linkedin.com/in/av-soluvirtus/"
							]
						},
						"address": {
							"@type": "PostalAddress",
							"addressLocality": "Ciudad de México",
							"addressRegion": "CDMX",
							"addressCountry": "MX"
						},
						"areaServed": [
							{ "@type": "Country", "name": "Mexico" },
							{ "@type": "Country", "name": "United States" },
							{ "@type": "Country", "name": "Latin America" }
						],
						"sameAs": [
							"https://www.linkedin.com/in/av-soluvirtus/"
						],
						"knowsAbout": [
							"Software Engineering",
							"Autonomous AI Agents & Tool Calling",
							"Business Process Automation",
							"RAG & Vector Embeddings (PyMuPDF, pgvector)",
							"Full-Stack Web Engineering (Next.js, Astro, React, Supabase)",
							"Local LLM Deployment & Data Sovereignty",
							"QA Automation (Pytest, Selenium E2E)",
							"Headless E-Commerce Architectures"
						],
						"hasOfferCatalog": {
							"@type": "OfferCatalog",
							"name": "Catálogo de Soluciones de Ingeniería Soluvirtus",
							"itemListElement": [
								{
									"@type": "Offer",
									"itemOffered": {
										"@type": "Service",
										"name": "Diagnóstico y Auditoría de Automatización Express",
										"description": "Evaluación técnica de procesos manuales y plan de automatización con agentes de IA."
									}
								},
								{
									"@type": "Offer",
									"itemOffered": {
										"@type": "Service",
										"name": "Ingeniería de Software a Medida (Anti-CMS)",
										"description": "Desarrollo de aplicaciones web y plataformas transaccionales de alto rendimiento con Astro, Next.js y Supabase."
									}
								},
								{
									"@type": "Offer",
									"itemOffered": {
										"@type": "Service",
										"name": "Infraestructura de IA Soberana y LLMs Locales",
										"description": "Despliegue de modelos de pesos abiertos en hardware local privado sin costos por token ni fuga de datos confidenciales."
									}
								},
								{
									"@type": "Offer",
									"itemOffered": {
										"@type": "Service",
										"name": "Pipelines de Scraping Ético y RAG para Catálogos",
										"description": "Extracción automatizada de datos, normalización de especificaciones técnicas y búsqueda semántica para inventarios densos."
									}
								}
							]
						}
					},
					{
						"@type": "FAQPage",
						"@id": "https://soluvirtus.com/#faq",
						"mainEntity": [
							{
								"@type": "Question",
								"name": "¿Cómo equilibra Soluvirtus la privacidad de datos con la potencia de los modelos comerciales de IA?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "Soluvirtus implementa una arquitectura híbrida de IA. Para información sensible, propiedad intelectual y contratos confidenciales, desplegamos modelos de pesos abiertos (Llama 3, Mistral) en servidores locales privados donde los datos nunca salen de la infraestructura del cliente y el costo por token es de $0.00 USD. Cuando se requiere razonamiento multimodal o flujos elásticos avanzados, orquestamos pragmáticamente APIs comerciales líderes (OpenAI, Anthropic) bajo capas de anonimización y políticas empresariales de cero retención."
								}
							},
							{
								"@type": "Question",
								"name": "¿Por qué Soluvirtus utiliza arquitecturas modernas en lugar de monolitos CMS tradicionales como WordPress?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "WordPress y otros CMS monolíticos sufren de alta latencia, sobrecarga de plugins vulnerables y rigidez arquitectónica. Soluvirtus desarrolla plataformas headless y estáticas con Astro, Next.js, React y Supabase con seguridad RLS, logrando tiempos de carga inferiores a 150ms en el Edge y total libertad para integrar agentes autónomos."
								}
							},
							{
								"@type": "Question",
								"name": "¿Qué significa un enfoque Agent-First frente a automatizaciones tradicionales?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "A diferencia de las herramientas no-code tradicionales que se quiebran ante cambios de interfaz o formato, un sistema Agent-First utiliza agentes de IA con capacidad de razonamiento que interpretan documentos no estructurados, toman decisiones condicionadas y ejecutan flujos complejos de forma autónoma."
								}
							},
							{
								"@type": "Question",
								"name": "¿Qué es el enfoque QA-First de Soluvirtus y cómo protege a los clientes?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "Soluvirtus diseña e implementa pruebas automatizadas unitarias, de integración de APIs REST y pruebas E2E con herramientas como Pytest y Selenium antes de liberar a producción. Esto garantiza software robusto, sin deuda técnica oculta ni caídas inesperadas en flujos de ingresos."
								}
							},
							{
								"@type": "Question",
								"name": "¿Cuál es el tiempo de entrega y retorno de inversión de un pipeline de automatización?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "Un flujo inicial de automatización o scraper se entrega entre 2 y 3 semanas. La mayoría de los clientes recuperan su inversión en 60 a 90 días al liberar hasta un 70% del tiempo operativo que su equipo dedicaba a procesos mecánicos."
								}
							},
							{
								"@type": "Question",
								"name": "¿Qué tecnologías componen el stack de desarrollo full-stack de Soluvirtus?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "Astro y Next.js con React para interfaces de usuario rápidas; Tailwind CSS para diseño responsivo; Python (PyMuPDF, Pytest, Selenium) para automatizaciones y pipelines de datos; y Supabase (PostgreSQL) con políticas de seguridad a nivel de fila (RLS)."
								}
							},
							{
								"@type": "Question",
								"name": "¿Cómo se gestiona el soporte continuo y mantenimiento?",
								"acceptedAnswer": {
									"@type": "Answer",
									"text": "Todo el código es propiedad del cliente y 100% documentado. Adicionalmente, ofrecemos acompañamiento mensual para optimización de prompts, actualización de modelos locales y monitoreo continuo de agentes y scrapers."
								}
							}
						]
					}
				]
			}
		</script>

		<!-- Script to set default dark/light mode based on system preference -->
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList.toggle('dark', isDark);
		</script>
	</head>
	<body class="bg-brand-bg-light dark:bg-brand-bg-dark text-brand-text-light secondary-text dark:text-brand-text-dark font-mono transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family: 'Roboto Mono', monospace;
	}
	
	/* Sugerencia 15: Transición global suave para cambios de tema */
	body,
	nav,
	div,
	section,
	table,
	tr,
	td,
	th,
	button,
	span,
	h1, h2, h3, h4, h5, h6,
	a,
	p,
	svg,
	input,
	textarea {
		transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease, box-shadow 0.4s ease, text-shadow 0.4s ease, opacity 0.4s ease;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(4px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fadeIn 0.25s ease-out forwards;
	}

	.text-neon-glow {
		text-shadow: 0 0 8px rgba(2, 132, 199, 0.2);
	}
	.dark .text-neon-glow {
		text-shadow: 0 0 8px rgba(0, 240, 255, 0.5), 0 0 15px rgba(0, 240, 255, 0.2);
	}

	/* Scroll Reveal */
	.reveal {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.reveal-active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Sugerencia 4: Gradiente Animado */
	@keyframes gradientMove {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}
	.animate-gradient {
		background-size: 200% 200%;
		animation: gradientMove 12s ease infinite;
	}
</style>
