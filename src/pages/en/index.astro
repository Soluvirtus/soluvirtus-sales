<script>
	// Theme script
	const themeLight = document.getElementById('theme-light');
	const themeDark = document.getElementById('theme-dark');
	const themeSystem = document.getElementById('theme-system');

	const setTheme = (theme: 'light' | 'dark' | 'system') => {
		if (theme === 'system') {
			localStorage.removeItem('theme');
			const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', isDark);
		} else {
			localStorage.setItem('theme', theme);
			document.documentElement.classList.toggle('dark', theme === 'dark');
		}
	};

	themeLight?.addEventListener('click', () => setTheme('light'));
	themeDark?.addEventListener('click', () => setTheme('dark'));
	themeSystem?.addEventListener('click', () => setTheme('system'));

	// Typewriter effect
	const words = [
		"Delegating Tasks",
		"Integrating AI in Your Business",
		"Automating Processes",
		"Increasing Sales Speed",
		"Storing and Delivering Information",
		"Service Inquiries"
	];
	let wordIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	const dynamicWordEl = document.getElementById('dynamic-word');

	const typeEffect = () => {
		if (!dynamicWordEl) return;
		const currentWord = words[wordIndex];
		
		if (isDeleting) {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex - 1);
			charIndex--;
		} else {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex + 1);
			charIndex++;
		}

		let typeSpeed = isDeleting ? 30 : 75;

		if (!isDeleting && charIndex === currentWord.length) {
			typeSpeed = 2000;
			isDeleting = true;
		} else if (isDeleting && charIndex === 0) {
			isDeleting = false;
			wordIndex = (wordIndex + 1) % words.length;
			typeSpeed = 500;
		}

		setTimeout(typeEffect, typeSpeed);
	};

	setTimeout(typeEffect, 1000);

	// Terminal simulation logic (Suggestion 26)
	const termScreen = document.getElementById('terminal-screen');
	const btnCatalog = document.getElementById('btn-demo-catalog');
	const btnLeads = document.getElementById('btn-demo-leads');
	const btnLlm = document.getElementById('btn-demo-llm');

	const simulations = {
		catalog: [
			{ text: "> soluvirtus run catalog-ai", color: "text-slate-300 font-bold" },
			{ text: "[system] Initializing catalog-ai-agent...", color: "text-slate-500" },
			{ text: "[system] Loading local inventory database (2,400 products)...", color: "text-slate-500" },
			{ text: '[agent] Analyzing customer query: "Looking for a tablet with a screen over 10 inches..."', color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Scanning product catalog and specifications...", color: "text-slate-400" },
			{ text: "[agent] Product found: Samsung Galaxy Tab A7 (10.4\", 32GB, Gray) - Price: 4,500 MXN", color: "text-emerald-400 font-semibold" },
			{ text: "[agent] Generating custom response with Stripe payment link...", color: "text-slate-400" },
			{ text: "[system] Response successfully sent via local API channel. Task completed.", color: "text-sky-400" }
		],
		leads: [
			{ text: "> soluvirtus run lead-scraper", color: "text-slate-300 font-bold" },
			{ text: "[system] Initializing lead-scraper-agent...", color: "text-slate-500" },
			{ text: "[system] Connecting to real estate data sources and public listings...", color: "text-slate-500" },
			{ text: "[agent] Analyzing property listings in metropolitan area...", color: "text-slate-400" },
			{ text: "[agent] Lead detected: Owner selling in Roma neighborhood. Price below average value.", color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Extracting contact details and applying lead scoring filters...", color: "text-slate-400" },
			{ text: "[system] Lead saved to Supabase database (Score: 94/100). Notification sent.", color: "text-emerald-400 font-semibold" }
		],
		llm: [
			{ text: "> soluvirtus run local-llm --model llama3-8b", color: "text-slate-300 font-bold" },
			{ text: "[system] Connecting to local open-source LLM (Llama-3-8B-Instruct)...", color: "text-slate-500" },
			{ text: "[system] Loading secure corporate context (Data Sovereignty)...", color: "text-slate-500" },
			{ text: '[user] Query: "What is the internal data retention policy?"', color: "text-slate-300" },
			{ text: "[agent] Processing tokens locally (No external calls to commercial APIs)...", color: "text-slate-400" },
			{ text: '[agent] Response: "All information is stored locally using robust RLS security."', color: "text-emerald-400 font-semibold" },
			{ text: "[system] Execution completed. External API cost: 0.00 USD.", color: "text-sky-400" }
		]
	};

	let running = false;
	const runSimulation = (key: 'catalog' | 'leads' | 'llm') => {
		if (running || !termScreen) return;
		running = true;
		termScreen.innerHTML = '';
		
		const lines = simulations[key];
		let currentLine = 0;

		const printLine = () => {
			if (currentLine >= lines.length) {
				running = false;
				return;
			}
			const line = lines[currentLine];
			const div = document.createElement('div');
			div.className = `${line.color} animate-fade-in`;
			div.textContent = line.text;
			termScreen.appendChild(div);
			termScreen.scrollTop = termScreen.scrollHeight;
			currentLine++;
			setTimeout(printLine, 800 + Math.random() * 400);
		};

		printLine();
	};

	btnCatalog?.addEventListener('click', () => runSimulation('catalog'));
	btnLeads?.addEventListener('click', () => runSimulation('leads'));
	btnLlm?.addEventListener('click', () => runSimulation('llm'));

	// FAQ accordion logic (Suggestion 20)
	const faqToggles = document.querySelectorAll('.faq-toggle');
	faqToggles.forEach(toggle => {
		toggle.addEventListener('click', () => {
			const answer = toggle.nextElementSibling as HTMLElement;
			const icon = toggle.querySelector('svg');
			
			if (answer && icon) {
				const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
				
				// Close all other FAQs
				document.querySelectorAll('.faq-answer').forEach(el => {
					(el as HTMLElement).style.maxHeight = '0px';
				});
				document.querySelectorAll('.faq-toggle svg').forEach(svg => {
					(svg as HTMLElement).classList.remove('rotate-180');
				});
				
				if (!isOpen) {
					answer.style.maxHeight = `${answer.scrollHeight}px`;
					icon.classList.add('rotate-180');
				} else {
					answer.style.maxHeight = '0px';
					icon.classList.remove('rotate-180');
				}
			}
		});
	});

	// Contact form service pre-selection (Suggestion 22)
	const cotizarBtns = document.querySelectorAll('.cotizar-btn');
	const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
	const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement | null;

	cotizarBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const service = btn.getAttribute('data-service');
			if (serviceSelect && service) {
				serviceSelect.value = service;
			}
			if (messageTextarea) {
				setTimeout(() => {
					messageTextarea.focus();
				}, 100);
			}
		});
	});

	// Scroll Reveal Animations (Suggestion 1)
	const revealElements = document.querySelectorAll('.reveal');
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('reveal-active');
				revealObserver.unobserve(entry.target);
			}
		});
	}, {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	});

	revealElements.forEach(el => revealObserver.observe(el));
</script>
