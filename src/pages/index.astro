---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="SOLUVIRTUS - Consultora de Tecnología, IA Soberana y Desarrollo Web"
	description="Acelera, delega y simplifica el trabajo de tu empresa. Automatización con agentes de IA, desarrollo web de alto rendimiento y consultoría de ingeniería a la medida."
	lang="es"
>
	<!-- Navigation -->
	<nav class="fixed top-0 left-0 w-full z-50 bg-brand-bg-light/80 dark:bg-brand-bg-dark/80 backdrop-blur-md border-b border-slate-200 dark:border-brand-bg-darkSecondary transition-colors duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between h-20">
				<div class="flex items-center">
					<a href="#" class="text-lg md:text-xl font-bold tracking-wider md:tracking-widest whitespace-nowrap text-brand-accent-light dark:text-brand-accent text-neon-glow transition-all duration-300">
						SOLUVIRTUS
					</a>
				</div>
				<div class="hidden md:block">
					<div class="ml-10 flex items-baseline space-x-6">
						<a href="#services" class="text-sm font-medium hover:text-brand-accent-light dark:hover:text-brand-accent transition-colors">Especialidades</a>
						<a href="#projects" class="text-sm font-medium hover:text-brand-accent-light dark:hover:text-brand-accent transition-colors">Proyectos</a>
						<a href="#philosophie" class="text-sm font-medium hover:text-brand-accent-light dark:hover:text-brand-accent transition-colors">Filosofía</a>
						<a href="#contact" class="text-sm font-medium hover:text-brand-accent-light dark:hover:text-brand-accent transition-colors">Contacto</a>
					</div>
				</div>
				<div class="flex items-center space-x-4">
					<!-- Language Switcher -->
					<a href="/en/" class="text-xs font-bold px-2 py-1 bg-slate-200/80 dark:bg-brand-bg-darkSecondary rounded border border-slate-300 dark:border-slate-800 hover:text-brand-accent-light dark:hover:text-brand-accent transition-colors" title="View in English">
						EN
					</a>
					<!-- Theme Toggles -->
					<div class="flex items-center bg-slate-200/50 dark:bg-brand-bg-darkSecondary p-1 rounded-full border border-slate-300 dark:border-slate-800 transition-colors">
						<button id="theme-light" class="p-1.5 rounded-full text-slate-600 dark:text-slate-400 hover:text-brand-accent-light dark:hover:text-brand-accent hover:bg-white dark:hover:bg-slate-800 transition-all" title="Modo Claro">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
						</button>
						<button id="theme-system" class="p-1.5 rounded-full text-slate-600 dark:text-slate-400 hover:text-brand-accent-light dark:hover:text-brand-accent hover:bg-white dark:hover:bg-slate-800 transition-all" title="Preferencia del Sistema">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" /></svg>
						</button>
						<button id="theme-dark" class="p-1.5 rounded-full text-slate-600 dark:text-slate-400 hover:text-brand-accent-light dark:hover:text-brand-accent hover:bg-white dark:hover:bg-slate-800 transition-all" title="Modo Oscuro">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
						</button>
					</div>
				</div>
			</div>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center justify-center pt-24 overflow-hidden bg-gradient-to-b from-slate-100 to-white dark:from-brand-bg-dark dark:to-brand-bg-darkSecondary transition-colors duration-300">
		<!-- Light mode background image -->
		<div class="absolute inset-0 bg-cover bg-center opacity-40 dark:hidden transition-opacity pointer-events-none" style="background-image: url('/images/hero_bg_light.png'); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%);"></div>
		<!-- Dark mode background image -->
		<div class="hidden dark:block absolute inset-0 bg-cover bg-center opacity-20 transition-opacity pointer-events-none" style="background-image: url('/images/hero_bg.png'); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%);"></div>
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-sky-200/20 via-transparent to-transparent dark:from-brand-accent/5 dark:via-transparent dark:to-transparent animate-gradient"></div>
		<div class="relative max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center">
			<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-800 to-slate-700 dark:from-white dark:via-slate-200 dark:to-brand-accent">
				Acelera, Delega y Simplifica tu trabajo
			</h1>
			
			<!-- Technical Authority Badge (Antítesis de WordPress) -->
			<div class="mb-4 flex flex-wrap items-center justify-center gap-2">
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400">
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
					100% Ingeniería a Medida · Cero CMS Lentos
				</span>
				<span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-medium bg-slate-200/60 dark:bg-brand-bg-darkSecondary border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300">
					Astro · Next.js · Supabase · IA Local
				</span>
			</div>

			<div class="mb-6">
				<span class="inline-block px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold tracking-widest uppercase bg-slate-200/50 dark:bg-brand-bg-darkSecondary/80 border border-slate-300 dark:border-slate-800 text-brand-accent-light dark:text-brand-accent dark:drop-shadow-[0_0_8px_rgba(0,240,255,0.4)]">
					&gt; Agilización _ Automatización
				</span>
			</div>
			<div class="text-base sm:text-xl font-medium text-slate-600 dark:text-slate-400 mb-10 min-h-[4rem] sm:min-h-0 flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2">
				<span>Excelente para:</span>
				<span id="dynamic-word" class="text-brand-accent-light dark:text-brand-accent border-r-2 border-brand-accent-light dark:border-brand-accent pr-1 font-bold">Delegar Tareas</span>
			</div>
			<div class="max-w-3xl mx-auto px-2 sm:px-0 mb-12 text-base sm:text-lg text-slate-600 dark:text-brand-text-darkSecondary leading-relaxed space-y-4 font-light text-center">
				<p>
					<span class="text-brand-accent-light dark:text-brand-accent font-bold tracking-wider text-neon-glow">SOLUVIRTUS</span> es una consultora de tecnología enfocada en la <span class="font-semibold text-slate-900 dark:text-white">optimización y automatización de negocios</span>, así como en la ingeniería de <span class="font-semibold text-slate-900 dark:text-white">software a la medida</span>.
				</p>
				<p>
					Nuestro enfoque prioritario es la eficiencia de protocolos de negocio y la <span class="font-semibold text-slate-900 dark:text-white">automatización sólida de procesos nativos</span>. Una vez establecida una base estructural óptima, integramos <span class="font-semibold text-slate-900 dark:text-white">soluciones avanzadas de Inteligencia Artificial</span> bajo un paradigma <span class="font-bold text-brand-accent-light dark:text-brand-accent text-neon-glow">"agent-first"</span>, reservando su uso exclusivamente para flujos de alto valor donde la IA aporta una verdadera <span class="font-semibold text-slate-900 dark:text-white">ventaja estratégica</span>.
				</p>
			</div>
			<div class="flex flex-wrap items-center justify-center gap-4">
				<a href="#audit-tool" class="px-8 py-3.5 bg-brand-accent-light hover:bg-brand-accent-lightHover dark:bg-brand-accent dark:hover:bg-brand-accent-hover text-white dark:text-slate-900 font-bold rounded-lg transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg shadow-sky-500/20 dark:shadow-brand-accent/20 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>
					Diagnóstico Express Gratis
				</a>
				<a href="#roi-calculator" class="px-7 py-3.5 bg-white/80 dark:bg-brand-bg-darkSecondary/80 hover:bg-slate-100 dark:hover:bg-brand-bg-darkSecondary border border-slate-300 dark:border-slate-700 rounded-lg font-bold text-slate-800 dark:text-slate-200 transition-all flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-brand-accent-light dark:text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
					Calcular ROI y Ahorro
				</a>
				<a href="#contact" class="px-6 py-3.5 bg-transparent hover:bg-slate-100 dark:hover:bg-white/5 border border-slate-300 dark:border-slate-800 rounded-lg font-medium text-slate-600 dark:text-slate-300 transition-all">
					Contacto Directo
				</a>
			</div>
		</div>
	</section>

	<!-- Lead Magnet / Diagnóstico Express Interactivo (CRO & Lead Capture) -->
	<section id="audit-tool" class="py-20 bg-slate-100/70 dark:bg-brand-bg-darkSecondary/30 border-t border-slate-200 dark:border-brand-bg-darkSecondary transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
			<div class="p-8 sm:p-12 bg-white dark:bg-brand-bg-darkSecondary/60 backdrop-blur-md rounded-3xl border border-slate-300 dark:border-white/10 shadow-xl relative overflow-hidden">
				<div class="absolute -top-24 -right-24 w-72 h-72 bg-brand-accent-light/10 dark:bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>
				
				<div class="text-center max-w-3xl mx-auto mb-10">
					<span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-accent-light/10 dark:bg-brand-accent/10 text-brand-accent-light dark:text-brand-accent mb-3">
						Evaluación Express Sin Costo
					</span>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-4">
						Diagnóstico de Automatización y Ahorro para tu Negocio
					</h2>
					<p class="text-slate-600 dark:text-brand-text-darkSecondary text-base sm:text-lg">
						Descubre en 60 segundos qué procesos de tu empresa están consumiendo tiempo y dinero innecesario y recibe una hoja de ruta con agentes de IA y flujos autónomos recomendados.
					</p>
				</div>

				<form id="audit-form" class="space-y-6 max-w-3xl mx-auto">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
								Tu Nombre o Empresa *
							</label>
							<input type="text" id="audit-name" required placeholder="Ej. Carlos Mendoza / Inmobiliaria Elite" class="w-full bg-slate-50 dark:bg-brand-bg-dark p-3.5 rounded-xl border border-slate-300 dark:border-slate-700 focus:outline-none focus:border-brand-accent transition-colors text-slate-900 dark:text-slate-100 text-sm" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
								Correo Corporativo *
							</label>
							<input type="email" id="audit-email" required placeholder="tu@empresa.com" class="w-full bg-slate-50 dark:bg-brand-bg-dark p-3.5 rounded-xl border border-slate-300 dark:border-slate-700 focus:outline-none focus:border-brand-accent transition-colors text-slate-900 dark:text-slate-100 text-sm" />
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
								WhatsApp de Contacto Directo *
							</label>
							<input type="tel" id="audit-phone" required placeholder="+52 55 1234 5678" class="w-full bg-slate-50 dark:bg-brand-bg-dark p-3.5 rounded-xl border border-slate-300 dark:border-slate-700 focus:outline-none focus:border-brand-accent transition-colors text-slate-900 dark:text-slate-100 text-sm" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
								Área Crítica a Optimizar *
							</label>
							<select id="audit-area" class="w-full bg-slate-50 dark:bg-brand-bg-dark p-3.5 rounded-xl border border-slate-300 dark:border-slate-700 focus:outline-none focus:border-brand-accent transition-colors text-slate-900 dark:text-slate-200 text-sm">
								<option value="leads">Prospección y captura de clientes (Scrapers & CRM)</option>
								<option value="catalog">Gestión de Catálogos & Inventarios Masivos</option>
								<option value="ai_local">Privacidad de Datos / IA Local sin costos por token</option>
								<option value="web_app">Reemplazo de sitio WordPress o software lento</option>
								<option value="workflows">Automatización de Tareas Repetitivas del Equipo</option>
							</select>
						</div>
					</div>

					<div>
						<label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
							¿Cuántas horas semanales pierde tu equipo en tareas operativas manuales?
						</label>
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-xs font-semibold">
							<label class="cursor-pointer border border-slate-300 dark:border-slate-700 p-3 rounded-xl hover:border-brand-accent bg-slate-50 dark:bg-brand-bg-dark has-[:checked]:border-brand-accent has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-brand-accent/10 transition-all">
								<input type="radio" name="audit-hours" value="1-5" class="sr-only" checked />
								<span>1 a 5 hrs/sem</span>
							</label>
							<label class="cursor-pointer border border-slate-300 dark:border-slate-700 p-3 rounded-xl hover:border-brand-accent bg-slate-50 dark:bg-brand-bg-dark has-[:checked]:border-brand-accent has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-brand-accent/10 transition-all">
								<input type="radio" name="audit-hours" value="6-15" class="sr-only" />
								<span>6 a 15 hrs/sem</span>
							</label>
							<label class="cursor-pointer border border-slate-300 dark:border-slate-700 p-3 rounded-xl hover:border-brand-accent bg-slate-50 dark:bg-brand-bg-dark has-[:checked]:border-brand-accent has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-brand-accent/10 transition-all">
								<input type="radio" name="audit-hours" value="16-30" class="sr-only" />
								<span>16 a 30 hrs/sem</span>
							</label>
							<label class="cursor-pointer border border-slate-300 dark:border-slate-700 p-3 rounded-xl hover:border-brand-accent bg-slate-50 dark:bg-brand-bg-dark has-[:checked]:border-brand-accent has-[:checked]:bg-sky-50 dark:has-[:checked]:bg-brand-accent/10 transition-all">
								<input type="radio" name="audit-hours" value="30+" class="sr-only" />
								<span>+30 hrs/sem (Crítico)</span>
							</label>
						</div>
					</div>

					<button type="submit" id="btn-submit-audit" class="w-full py-4 bg-brand-accent-light hover:bg-brand-accent-lightHover dark:bg-brand-accent dark:hover:bg-brand-accent-hover text-white dark:text-slate-900 font-bold rounded-xl transition-all duration-300 text-base shadow-lg shadow-sky-500/20 dark:shadow-brand-accent/20 flex items-center justify-center gap-3">
						<span>Generar Diagnóstico y Enviar a WhatsApp / Correo</span>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
					</button>
				</form>

				<!-- Feedback de éxito interactivo -->
				<div id="audit-success-box" class="hidden mt-8 p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-slate-800 dark:text-slate-200">
					<div class="flex items-start gap-4">
						<div class="w-10 h-10 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center font-bold text-xl flex-shrink-0">
							✓
						</div>
						<div class="space-y-2 flex-grow">
							<h4 class="font-bold text-lg text-emerald-600 dark:text-emerald-400">¡Diagnóstico Registrado con Éxito!</h4>
							<p class="text-sm text-slate-600 dark:text-slate-300" id="audit-result-text">
								Hemos guardado tu perfil de optimización. Para recibir tu hoja de ruta personalizada de inmediato, abre el canal directo de WhatsApp:
							</p>
							<div class="pt-2 flex flex-wrap gap-3">
								<a id="audit-whatsapp-link" href="#" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg text-sm transition-all inline-flex items-center gap-2 shadow-md">
									Continuar en WhatsApp &rarr;
								</a>
								<a href="https://calendar.app.google/f4zwVLC3juqPxj27A" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-lg text-sm transition-all inline-flex items-center gap-2 shadow-md hover:bg-slate-800 dark:hover:bg-slate-100">
									<svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9v-2h2v2zm0-4H9V7h2v5z"/></svg>
									Agendar en Google Meet (20 min)
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Calculadora Interactiva de ROI (Sugerencia 25) -->
	<section id="roi-calculator" class="py-20 bg-white dark:bg-brand-bg-dark border-t border-slate-200 dark:border-brand-bg-darkSecondary transition-colors duration-300">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
			<div class="text-center max-w-3xl mx-auto mb-12">
				<span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-100 dark:bg-brand-accent/10 text-brand-accent-light dark:text-brand-accent mb-3">
					Simulador de Retorno de Inversión
				</span>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-4">
					¿Cuánto te cuesta la ineficiencia operativa?
				</h2>
				<p class="text-lg text-slate-600 dark:text-brand-text-darkSecondary">
					Mueve los controles para estimar el costo mensual de tareas manuales repetitivas y el potencial de ahorro con automatizaciones nativas e IA.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
				<!-- Controles -->
				<div class="lg:col-span-7 p-8 bg-slate-50 dark:bg-brand-bg-darkSecondary/40 rounded-3xl border border-slate-200 dark:border-slate-800 space-y-6">
					<div>
						<div class="flex justify-between items-center mb-2">
							<label class="text-sm font-bold text-slate-800 dark:text-slate-200">
								Personas realizando tareas manuales repetitivas:
							</label>
							<span id="roi-people-val" class="font-mono text-lg font-bold text-brand-accent-light dark:text-brand-accent">3 colaboradores</span>
						</div>
						<input type="range" id="roi-people" min="1" max="25" value="3" class="w-full h-2 bg-slate-300 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-sky-600 dark:accent-brand-accent" />
					</div>

					<div>
						<div class="flex justify-between items-center mb-2">
							<label class="text-sm font-bold text-slate-800 dark:text-slate-200">
								Horas diarias dedicadas a procesos manuales (por persona):
							</label>
							<span id="roi-hours-val" class="font-mono text-lg font-bold text-brand-accent-light dark:text-brand-accent">2.5 horas/día</span>
						</div>
