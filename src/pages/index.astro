			<div class="flex flex-wrap justify-center items-center gap-6 text-xs text-slate-400 font-mono">
				<span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>Stack: Astro 4 · Tailwind CSS · Supabase</span>
				<span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Soberanía de Datos Garantizada</span>
				<span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>Rendimiento Estático en el Edge</span>
			</div>
			<p class="text-slate-400">© 2026 Soluvirtus. Encontrando soluciones, Impulsando virtudes.</p>
			<p class="text-xs">
				Desarrollado y operado de forma independiente por 
				<a href="https://www.linkedin.com/in/av-soluvirtus/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors underline decoration-brand-accent/50 underline-offset-4 font-semibold">Antonio Ávila</a>
			</p>
		</div>
	</footer>
</Layout>

<script>
	// Theme script
	const themeLight = document.getElementById('theme-light');
	const themeDark = document.getElementById('theme-dark');
	const themeSystem = document.getElementById('theme-system');

	const setTheme = (theme: 'light' | 'dark' | 'system') => {
		if (theme === 'system') {
			localStorage.removeItem('theme');
			const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', isDark);
		} else {
			localStorage.setItem('theme', theme);
			document.documentElement.classList.toggle('dark', theme === 'dark');
		}
	};

	themeLight?.addEventListener('click', () => setTheme('light'));
	themeDark?.addEventListener('click', () => setTheme('dark'));
	themeSystem?.addEventListener('click', () => setTheme('system'));

	// Typewriter effect
	const words = [
		"Delegar Tareas",
		"Incluir IA en tu negocio",
		"Automatizar Procesos",
		"Incrementar la velocidad de Ventas",
		"Guardar y entregar Información",
		"Consultas de Servicios"
	];
	let wordIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	const dynamicWordEl = document.getElementById('dynamic-word');

	const typeEffect = () => {
		if (!dynamicWordEl) return;
		const currentWord = words[wordIndex];
		
		if (isDeleting) {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex - 1);
			charIndex--;
		} else {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex + 1);
			charIndex++;
		}

		let typeSpeed = isDeleting ? 30 : 75;

		if (!isDeleting && charIndex === currentWord.length) {
			typeSpeed = 2000;
			isDeleting = true;
		} else if (isDeleting && charIndex === 0) {
			isDeleting = false;
			wordIndex = (wordIndex + 1) % words.length;
			typeSpeed = 500;
		}

		setTimeout(typeEffect, typeSpeed);
	};

	setTimeout(typeEffect, 1000);

	// Terminal simulation logic (Sugerencia 26)
	const termScreen = document.getElementById('terminal-screen');
	const btnCatalog = document.getElementById('btn-demo-catalog');
	const btnLeads = document.getElementById('btn-demo-leads');
	const btnLlm = document.getElementById('btn-demo-llm');

	const simulations = {
		catalog: [
			{ text: "> soluvirtus run catalog-ai", color: "text-slate-300 font-bold" },
			{ text: "[system] Inicializando agente catalog-ai-agent...", color: "text-slate-500" },
			{ text: "[system] Cargando base de datos local de inventario (2,400 productos)...", color: "text-slate-500" },
			{ text: '[agent] Analizando consulta del cliente: "Busco una tablet con pantalla de más de 10 pulgadas..."', color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Escaneando catálogo de productos y especificaciones...", color: "text-slate-400" },
			{ text: "[agent] Producto encontrado: Samsung Galaxy Tab A7 (10.4\", 32GB, Gris) - Precio: 4,500 MXN", color: "text-emerald-400 font-semibold" },
			{ text: "[agent] Generando respuesta personalizada con enlace de cobro de Stripe...", color: "text-slate-400" },
			{ text: "[system] Respuesta enviada exitosamente por canal API local. Tarea completada.", color: "text-sky-400" }
		],
		leads: [
			{ text: "> soluvirtus run lead-scraper", color: "text-slate-300 font-bold" },
			{ text: "[system] Inicializando agente lead-scraper-agent...", color: "text-slate-500" },
			{ text: "[system] Conectando a fuentes de datos inmobiliarios y listados públicos...", color: "text-slate-500" },
			{ text: "[agent] Analizando listados de propiedades en zona metropolitana...", color: "text-slate-400" },
			{ text: "[agent] Lead detectado: Propietario vende en Col. Roma. Precio bajo valor promedio.", color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Extrayendo datos de contacto y aplicando filtros de scoring de leads...", color: "text-slate-400" },
			{ text: "[system] Lead guardado en base de datos Supabase (Score: 94/100). Notificación enviada.", color: "text-emerald-400 font-semibold" }
		],
		llm: [
			{ text: "> soluvirtus run local-llm --model llama3-8b", color: "text-slate-300 font-bold" },
			{ text: "[system] Conectando a LLM de código abierto local (Llama-3-8B-Instruct)...", color: "text-slate-500" },
			{ text: "[system] Cargando contexto corporativo seguro (Soberanía de Datos)...", color: "text-slate-500" },
			{ text: '[user] Consulta: "¿Cuál es la política de retención de datos interna?"', color: "text-slate-300" },
			{ text: "[agent] Procesando tokens localmente (Sin llamadas externas a APIs comerciales)...", color: "text-slate-400" },
			{ text: '[agent] Respuesta: "Toda la información se almacena localmente usando seguridad robusta RLS."', color: "text-emerald-400 font-semibold" },
			{ text: "[system] Ejecución completada. Consumo de API externa: 0.00 USD.", color: "text-sky-400" }
		]
	};

	let running = false;
	const runSimulation = (key: 'catalog' | 'leads' | 'llm') => {
		if (running || !termScreen) return;
		running = true;
		termScreen.innerHTML = '';
		
		const lines = simulations[key];
		let currentLine = 0;

		const printLine = () => {
			if (currentLine >= lines.length) {
				running = false;
				return;
			}
			const line = lines[currentLine];
			const div = document.createElement('div');
			div.className = `${line.color} animate-fade-in`;
			div.textContent = line.text;
			termScreen.appendChild(div);
			termScreen.scrollTop = termScreen.scrollHeight;
			currentLine++;
			setTimeout(printLine, 800 + Math.random() * 400);
		};

		printLine();
	};

	btnCatalog?.addEventListener('click', () => runSimulation('catalog'));
	btnLeads?.addEventListener('click', () => runSimulation('leads'));
	btnLlm?.addEventListener('click', () => runSimulation('llm'));

	// FAQ accordion logic (Sugerencia 20)
	const faqToggles = document.querySelectorAll('.faq-toggle');
	faqToggles.forEach(toggle => {
		toggle.addEventListener('click', () => {
			const answer = toggle.nextElementSibling as HTMLElement;
			const icon = toggle.querySelector('svg');
			
			if (answer && icon) {
				const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
				
				// Close all other FAQs
				document.querySelectorAll('.faq-answer').forEach(el => {
					(el as HTMLElement).style.maxHeight = '0px';
				});
				document.querySelectorAll('.faq-toggle svg').forEach(svg => {
					(svg as HTMLElement).classList.remove('rotate-180');
				});
				
				if (!isOpen) {
					answer.style.maxHeight = `${answer.scrollHeight}px`;
					icon.classList.add('rotate-180');
				} else {
					answer.style.maxHeight = '0px';
					icon.classList.remove('rotate-180');
				}
			}
		});
	});

	// Contact form service pre-selection (Sugerencia 22)
	const cotizarBtns = document.querySelectorAll('.cotizar-btn');
	const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
	const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement | null;

	cotizarBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const service = btn.getAttribute('data-service');
			if (serviceSelect && service) {
				serviceSelect.value = service;
			}
			if (messageTextarea) {
				setTimeout(() => {
					messageTextarea.focus();
				}, 100);
			}
		});
	});

	// Scroll Reveal Animations (Sugerencia 1)
	const revealElements = document.querySelectorAll('.reveal');
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('reveal-active');
				revealObserver.unobserve(entry.target);
			}
		});
	}, {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	});

	revealElements.forEach(el => revealObserver.observe(el));

	// -------------------------------------------------------------
	// ROI Calculator Logic
	// -------------------------------------------------------------
	const roiPeople = document.getElementById('roi-people') as HTMLInputElement | null;
	const roiHours = document.getElementById('roi-hours') as HTMLInputElement | null;
	const roiCost = document.getElementById('roi-cost') as HTMLInputElement | null;

	const roiPeopleVal = document.getElementById('roi-people-val');
	const roiHoursVal = document.getElementById('roi-hours-val');
	const roiCostVal = document.getElementById('roi-cost-val');

	const roiWasteDisplay = document.getElementById('roi-waste-display');
	const roiHoursWaste = document.getElementById('roi-hours-waste');
	const roiSavingsDisplay = document.getElementById('roi-savings-display');
	const roiAnnualSavings = document.getElementById('roi-annual-savings');

	const updateROI = () => {
		if (!roiPeople || !roiHours || !roiCost) return;
		const people = parseFloat(roiPeople.value);
		const hoursPerDay = parseFloat(roiHours.value);
		const hourlyCost = parseFloat(roiCost.value);

		if (roiPeopleVal) roiPeopleVal.textContent = `${people} ${people === 1 ? 'colaborador' : 'colaboradores'}`;
		if (roiHoursVal) roiHoursVal.textContent = `${hoursPerDay} hrs/día`;
		if (roiCostVal) roiCostVal.textContent = `$${hourlyCost} MXN/hr`;

		// 21 working days per month
		const totalHoursMonth = people * hoursPerDay * 21;
		const monthlyCost = totalHoursMonth * hourlyCost;
		const monthlySavings = monthlyCost * 0.70;
		const annualSavings = monthlySavings * 12;

		if (roiWasteDisplay) {
			roiWasteDisplay.textContent = `$${Math.round(monthlyCost).toLocaleString('es-MX')} MXN / mes`;
		}
		if (roiHoursWaste) {
			roiHoursWaste.textContent = `${totalHoursMonth.toFixed(1)} horas mensuales invertidas en tareas mecánicas`;
		}
		if (roiSavingsDisplay) {
			roiSavingsDisplay.textContent = `$${Math.round(monthlySavings).toLocaleString('es-MX')} MXN / mes`;
		}
		if (roiAnnualSavings) {
			roiAnnualSavings.innerHTML = `Equivalente a <span class="text-brand-accent">$${Math.round(annualSavings).toLocaleString('es-MX')} MXN / año</span> recuperados`;
		}
	};

	roiPeople?.addEventListener('input', updateROI);
	roiHours?.addEventListener('input', updateROI);
	roiCost?.addEventListener('input', updateROI);
	updateROI();

	// -------------------------------------------------------------
	// Lead Magnet Audit Form (Local Storage + WhatsApp Pre-populated)
	// -------------------------------------------------------------
	const auditForm = document.getElementById('audit-form') as HTMLFormElement | null;
	const auditSuccessBox = document.getElementById('audit-success-box');
	const auditResultText = document.getElementById('audit-result-text');
	const auditWhatsappLink = document.getElementById('audit-whatsapp-link') as HTMLAnchorElement | null;

	auditForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = (document.getElementById('audit-name') as HTMLInputElement)?.value.trim();
		const email = (document.getElementById('audit-email') as HTMLInputElement)?.value.trim();
		const phone = (document.getElementById('audit-phone') as HTMLInputElement)?.value.trim();
		const area = (document.getElementById('audit-area') as HTMLSelectElement)?.value;
		const hoursEl = document.querySelector('input[name="audit-hours"]:checked') as HTMLInputElement | null;
		const hours = hoursEl ? hoursEl.value : 'N/A';

		const leadData = {
			name,
			email,
			phone,
			area,
			hoursLost: hours,
			timestamp: new Date().toISOString(),
			source: 'Express Audit Lead Magnet'
		};

		// 1. Guardar en LocalStorage para no perder prospectos
		try {
			const existingLeads = JSON.parse(localStorage.getItem('soluvirtus_leads') || '[]');
			existingLeads.push(leadData);
			localStorage.setItem('soluvirtus_leads', JSON.stringify(existingLeads));
		} catch (err) {
			console.warn('Storage warning', err);
		}

		// 2. Generar mensaje calificado para WhatsApp
		const areaLabels: Record<string, string> = {
			leads: 'Captura y Prospección de Leads (Scrapers & CRM)',
			catalog: 'Gestión de Catálogos e Inventarios Masivos',
			ai_local: 'IA Local Soberana (Privacidad sin costos de APIs)',
			web_app: 'Desarrollo Web de Alto Rendimiento (Astro/Next.js)',
			workflows: 'Automatización de Tareas Repetitivas del Equipo'
		};
		const areaName = areaLabels[area] || area;

		const waMessage = `Hola Antonio / Soluvirtus,%0A%0AHe completado el Diagnóstico de Automatización en su sitio web:%0A• *Nombre/Empresa:* ${encodeURIComponent(name)}%0A• *Correo:* ${encodeURIComponent(email)}%0A• *Teléfono:* ${encodeURIComponent(phone)}%0A• *Área Prioritaria:* ${encodeURIComponent(areaName)}%0A• *Horas semanales en tareas mecánicas:* ${encodeURIComponent(hours)} hrs/sem%0A%0AMe gustaría recibir la propuesta de roadmap para optimizar estos procesos.`;
		const waUrl = `https://wa.me/5215570603839?text=${waMessage}`;

		if (auditWhatsappLink) {
			auditWhatsappLink.href = waUrl;
		}

		if (auditResultText) {
			auditResultText.textContent = `Hola ${name}, hemos calculado tu perfil de optimización para ${areaName}. Tu pérdida estimada supera ${hours} horas semanales. Da clic a continuación para recibir la propuesta directamente:`;
		}

		if (auditSuccessBox) {
			auditSuccessBox.classList.remove('hidden');
		}

		// Abrir automáticamente WhatsApp en nueva pestaña para frictionless conversion
		window.open(waUrl, '_blank');
	});

	// -------------------------------------------------------------
	// Main Contact Form Handler (Lead Scoring & Direct WhatsApp)
	// -------------------------------------------------------------
	const mainContactForm = document.getElementById('main-contact-form') as HTMLFormElement | null;
	const contactSuccessBox = document.getElementById('contact-success-box');

	mainContactForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
		const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
		const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
		const service = (document.getElementById('contact-service') as HTMLSelectElement)?.value;
		const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

		const contactData = {
			name,
			email,
			phone,
			service,
			message,
			date: new Date().toISOString()
		};

		try {
			const messages = JSON.parse(localStorage.getItem('soluvirtus_contact_requests') || '[]');
			messages.push(contactData);
			localStorage.setItem('soluvirtus_contact_requests', JSON.stringify(messages));
		} catch (err) {
			console.warn('Storage warning', err);
		}

		const waMessage = `Hola Soluvirtus,%0A%0ASolicito cotización / asesoría:%0A• *Nombre:* ${encodeURIComponent(name)}%0A• *Correo:* ${encodeURIComponent(email)}%0A• *Teléfono:* ${encodeURIComponent(phone)}%0A• *Servicio:* ${encodeURIComponent(service)}%0A• *Detalles:* ${encodeURIComponent(message || 'Sin mensaje adicional')}`;
		const waUrl = `https://wa.me/5215570603839?text=${waMessage}`;

		if (contactSuccessBox) {
			contactSuccessBox.classList.remove('hidden');
		}

		window.open(waUrl, '_blank');
	});
</script>
