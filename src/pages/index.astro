						</button>
					</form>
				</div>
			</div>
		</div>
	</section>

	<footer class="py-8 bg-slate-950 text-slate-500 text-center text-sm border-t border-slate-900 dark:border-brand-bg-darkSecondary transition-colors">
		<p class="mb-2">© 2026 Soluvirtus. Encontrando soluciones, Impulsando virtudes.</p>
		<p class="text-xs">Desarrollado por <a href="https://soluvirtus.com/" class="hover:text-white transition-colors">Antonio Ávila</a></p>
	</footer>
</Layout>

<script>
	// Theme script
	const themeLight = document.getElementById('theme-light');
	const themeDark = document.getElementById('theme-dark');
	const themeSystem = document.getElementById('theme-system');

	const setTheme = (theme: 'light' | 'dark' | 'system') => {
		if (theme === 'system') {
			localStorage.removeItem('theme');
			const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', isDark);
		} else {
			localStorage.setItem('theme', theme);
			document.documentElement.classList.toggle('dark', theme === 'dark');
		}
	};

	themeLight?.addEventListener('click', () => setTheme('light'));
	themeDark?.addEventListener('click', () => setTheme('dark'));
	themeSystem?.addEventListener('click', () => setTheme('system'));

	// Typewriter effect
	const words = [
		"Delegar Tareas",
		"Incluir IA en tu negocio",
		"Automatizar Procesos",
		"Incrementar la velocidad de Ventas",
		"Guardar y entregar Información",
		"Consultas de Servicios"
	];
	let wordIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	const dynamicWordEl = document.getElementById('dynamic-word');

	const typeEffect = () => {
		if (!dynamicWordEl) return;
		const currentWord = words[wordIndex];
		
		if (isDeleting) {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex - 1);
			charIndex--;
		} else {
			dynamicWordEl.textContent = currentWord.substring(0, charIndex + 1);
			charIndex++;
		}

		let typeSpeed = isDeleting ? 30 : 75;

		if (!isDeleting && charIndex === currentWord.length) {
			typeSpeed = 2000;
			isDeleting = true;
		} else if (isDeleting && charIndex === 0) {
			isDeleting = false;
			wordIndex = (wordIndex + 1) % words.length;
			typeSpeed = 500;
		}

		setTimeout(typeEffect, typeSpeed);
	};

	setTimeout(typeEffect, 1000);

	// Terminal simulation logic (Sugerencia 26)
	const termScreen = document.getElementById('terminal-screen');
	const btnCatalog = document.getElementById('btn-demo-catalog');
	const btnLeads = document.getElementById('btn-demo-leads');
	const btnLlm = document.getElementById('btn-demo-llm');

	const simulations = {
		catalog: [
			{ text: "> soluvirtus run catalog-ai", color: "text-slate-300 font-bold" },
			{ text: "[system] Inicializando agente catalog-ai-agent...", color: "text-slate-500" },
			{ text: "[system] Cargando base de datos local de inventario (2,400 productos)...", color: "text-slate-500" },
			{ text: '[agent] Analizando consulta del cliente: "Busco una tablet con pantalla de más de 10 pulgadas..."', color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Escaneando catálogo de productos y especificaciones...", color: "text-slate-400" },
			{ text: "[agent] Producto encontrado: Samsung Galaxy Tab A7 (10.4\", 32GB, Gris) - Precio: 4,500 MXN", color: "text-emerald-400 font-semibold" },
			{ text: "[agent] Generando respuesta personalizada con enlace de cobro de Stripe...", color: "text-slate-400" },
			{ text: "[system] Respuesta enviada exitosamente por canal API local. Tarea completada.", color: "text-sky-400" }
		],
		leads: [
			{ text: "> soluvirtus run lead-scraper", color: "text-slate-300 font-bold" },
			{ text: "[system] Inicializando agente lead-scraper-agent...", color: "text-slate-500" },
			{ text: "[system] Conectando a fuentes de datos inmobiliarios y listados públicos...", color: "text-slate-500" },
			{ text: "[agent] Analizando listados de propiedades en zona metropolitana...", color: "text-slate-400" },
			{ text: "[agent] Lead detectado: Propietario vende en Col. Roma. Precio bajo valor promedio.", color: "text-brand-accent-light dark:text-brand-accent" },
			{ text: "[agent] Extrayendo datos de contacto y aplicando filtros de scoring de leads...", color: "text-slate-400" },
			{ text: "[system] Lead guardado en base de datos Supabase (Score: 94/100). Notificación enviada.", color: "text-emerald-400 font-semibold" }
		],
		llm: [
			{ text: "> soluvirtus run local-llm --model llama3-8b", color: "text-slate-300 font-bold" },
			{ text: "[system] Conectando a LLM de código abierto local (Llama-3-8B-Instruct)...", color: "text-slate-500" },
			{ text: "[system] Cargando contexto corporativo seguro (Soberanía de Datos)...", color: "text-slate-500" },
			{ text: '[user] Consulta: "¿Cuál es la política de retención de datos interna?"', color: "text-slate-300" },
			{ text: "[agent] Procesando tokens localmente (Sin llamadas externas a APIs comerciales)...", color: "text-slate-400" },
			{ text: '[agent] Respuesta: "Toda la información se almacena localmente usando seguridad robusta RLS."', color: "text-emerald-400 font-semibold" },
			{ text: "[system] Ejecución completada. Consumo de API externa: 0.00 USD.", color: "text-sky-400" }
		]
	};

	let running = false;
	const runSimulation = (key: 'catalog' | 'leads' | 'llm') => {
		if (running || !termScreen) return;
		running = true;
		termScreen.innerHTML = '';
		
		const lines = simulations[key];
		let currentLine = 0;

		const printLine = () => {
			if (currentLine >= lines.length) {
				running = false;
				return;
			}
			const line = lines[currentLine];
			const div = document.createElement('div');
			div.className = `${line.color} animate-fade-in`;
			div.textContent = line.text;
			termScreen.appendChild(div);
			termScreen.scrollTop = termScreen.scrollHeight;
			currentLine++;
			setTimeout(printLine, 800 + Math.random() * 400);
		};

		printLine();
	};

	btnCatalog?.addEventListener('click', () => runSimulation('catalog'));
	btnLeads?.addEventListener('click', () => runSimulation('leads'));
	btnLlm?.addEventListener('click', () => runSimulation('llm'));

	// FAQ accordion logic (Sugerencia 20)
	const faqToggles = document.querySelectorAll('.faq-toggle');
	faqToggles.forEach(toggle => {
		toggle.addEventListener('click', () => {
			const answer = toggle.nextElementSibling as HTMLElement;
			const icon = toggle.querySelector('svg');
			
			if (answer && icon) {
				const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
				
				// Close all other FAQs
				document.querySelectorAll('.faq-answer').forEach(el => {
					(el as HTMLElement).style.maxHeight = '0px';
				});
				document.querySelectorAll('.faq-toggle svg').forEach(svg => {
					(svg as HTMLElement).classList.remove('rotate-180');
				});
				
				if (!isOpen) {
					answer.style.maxHeight = `${answer.scrollHeight}px`;
					icon.classList.add('rotate-180');
				} else {
					answer.style.maxHeight = '0px';
					icon.classList.remove('rotate-180');
				}
			}
		});
	});

	// Contact form service pre-selection (Sugerencia 22)
	const cotizarBtns = document.querySelectorAll('.cotizar-btn');
	const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
	const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement | null;

	cotizarBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const service = btn.getAttribute('data-service');
			if (serviceSelect && service) {
				serviceSelect.value = service;
			}
			if (messageTextarea) {
				setTimeout(() => {
					messageTextarea.focus();
				}, 100);
			}
		});
	});

	// Scroll Reveal Animations (Sugerencia 1)
	const revealElements = document.querySelectorAll('.reveal');
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('reveal-active');
				revealObserver.unobserve(entry.target);
			}
		});
	}, {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	});

	revealElements.forEach(el => revealObserver.observe(el));
</script>
